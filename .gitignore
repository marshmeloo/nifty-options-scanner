# Secrets / credentials -- never commit these
.env
*.env
dhan_credentials*
*token*.txt
*access_token*

# Runtime data / logs (grows daily, not source)
*.log
nifty_scan_*.log
trade_journal.jsonl
# dedupe_journal.py backups -- real trade records, never commit
*.bak-*
# Recorded market history (~1.5 MB/day gzipped). This is valuable data --
# back it up somewhere, just not in git.
logs/snapshots/
logs/snapshots_banknifty/
logs/commodities/
# Recorded live order-book spread samples (~1-2 MB/day gzipped).
# Same reasoning as snapshots: valuable measurement data, but runtime
# output rather than source -- back it up outside git.
logs/orderflow/
# 5-minute index candles for the ORB study (~1.7 MB). Unlike the two
# above this is freely REGENERABLE -- `python orb_candle_cache.py`
# refetches the lot from Dhan in ~73 calls -- so it is a cache, not data
# worth preserving.
logs/orb_candles.json.gz
cmd-print-*.txt
sample_data.csv
state/*.json
logs/premarket_brief_*.md
logs/premarket_brief_*.json
logs/condor_*.log
logs/condor_journal.jsonl
# Per-cycle audit trail: runtime data, ~5 MB/day. Was tracked, which made
# every sync_from_prod.py run dirty the tree and broke the clean-tree
# check in the promotion procedure. History retains past versions.
logs/decision_log.jsonl

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Workspace role marker -- environment-specific, never shared
.workspace

# Stock intraday cache for the "stocks in play" research track (~200 MB,
# 208 symbols). Regenerable: python -m research.stock_data --backfill
logs/stock_candles/
logs/stock_universe.json
